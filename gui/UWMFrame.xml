<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Player Trading+ page (0.5): tabs INCOMING / OUTGOING / STANDING ORDERS, the last with sub-tabs MARKET / MY ORDERS /
     MY DEALS (user's layout, mock-up previews/menu_v1_*.png). Which parts show is switched in UWMFrame.lua.
     Geometry (2026-10-24): the tab container's content is inset 63px, so tables start at x -63px and run 1580px
     wide; column headings 14px into their box, line under them at -48, list from -50, bottom line at -723. Sub-tabs at
     -45 with their line at -102, the tables under them start at -112. Depot status + manager line: footer under -723. -->
<GUI name="UWMFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel" position="-62px 92px">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_uwm_menuTitle"/>
            <RoundCorner profile="fs25_shopMoneyBoxBg"/>
            <BoxLayout profile="fs25_shopMoneyBox">
                <Text profile="fs25_shopBalance" text="$l10n_uwm_balance"/>
                <Text profile="fs25_shopMoney" id="balanceText"/>
            </BoxLayout>
        </GuiElement>

        <!-- main tabs -->
        <BoxLayout profile="fs25_subCategorySelectorTabbedBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="mainTabs[1]" text="$l10n_uwm_tab_incoming" onClick="onClickTabIncoming">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="mainTabs[2]" text="$l10n_uwm_tab_outgoing" onClick="onClickTabOutgoing">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="mainTabs[3]" text="$l10n_uwm_tab_board" onClick="onClickTabBoard">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="-63px -57px" size="100% 2dp"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="mainPaging" position="0px -10px" onClick="onClickMainPaging"/>

        <GuiElement profile="fs25_subCategorySelectorTabbedContainer">

            <!-- INCOMING / OUTGOING (UWM CO-OP theme, mock-up previews/menu_v4_incoming.png, user OK'd 2026-10-28):
                 four summary cards, then every invoice as a card (goods icon tile, title, detail line, status,
                 amount, arrow). Shapes / icons = cells of gui/uwm_ui.dds ("uwmImg_<cell>" names, UWMGui.lua). -->
            <GuiElement profile="uwm_summaryBox" id="summaryBox">
                <GuiElement profile="uwm_sumCard" position="0px 0px">
                    <Bitmap profile="uwm_sumEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumStripGreen" name="uwmImg_solid"/>
                    <Text profile="uwm_sumLabel" text="$l10n_uwm_sum_waiting"/>
                    <Text profile="uwm_sumValue" id="sumValue[1]"/>
                    <Text profile="uwm_sumSub" id="sumSub[1]"/>
                </GuiElement>
                <GuiElement profile="uwm_sumCard" position="399px 0px">
                    <Bitmap profile="uwm_sumEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumStripBlue" name="uwmImg_solid"/>
                    <Text profile="uwm_sumLabel" text="$l10n_uwm_sum_running"/>
                    <Text profile="uwm_sumValue" id="sumValue[2]"/>
                    <Text profile="uwm_sumSub" id="sumSub[2]"/>
                </GuiElement>
                <GuiElement profile="uwm_sumCard" position="798px 0px">
                    <Bitmap profile="uwm_sumEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumStripOrange" name="uwmImg_solid"/>
                    <Text profile="uwm_sumLabel" text="$l10n_uwm_sum_collect"/>
                    <Text profile="uwm_sumValue" id="sumValue[3]"/>
                    <Text profile="uwm_sumSub" id="sumSub[3]"/>
                </GuiElement>
                <GuiElement profile="uwm_sumCard" position="1197px 0px">
                    <Bitmap profile="uwm_sumEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_sumStripGrey" name="uwmImg_solid"/>
                    <Text profile="uwm_sumLabel" text="$l10n_uwm_sum_forSale"/>
                    <Text profile="uwm_sumValue" id="sumValue[4]"/>
                    <Text profile="uwm_sumSub" id="sumSub[4]"/>
                </GuiElement>
            </GuiElement>
            <SmoothList profile="uwm_list" id="invoiceList" position="-63px -100px" size="100% 616px" listItemSpacing="12px">
                <ListItem profile="uwm_cardItem">
                    <Bitmap profile="uwm_cardEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardTile" name="uwmImg_tile"/>
                    <Bitmap profile="uwm_cardIcon" name="icon"/>
                    <Text profile="uwm_cardTitle" name="title"/>
                    <Text profile="uwm_cardSub" name="sub"/>
                    <Text profile="uwm_cardStatus" name="status"/>
                    <Text profile="uwm_cardAmount" name="amount"/>
                    <Bitmap profile="uwm_cardArrow" name="uwmImg_arrow"/>
                </ListItem>
            </SmoothList>
            <Text profile="uwm_emptyText" position="540px -350px" id="invoiceEmpty"/>

            <!-- STANDING ORDERS (UWM CO-OP theme, mock-up previews/menu_v5_standing.png, user OK'd 2026-10-30): the summary
                 cards stay on top, sub-tabs under them, every standing order / deal is a card like the invoices -->
            <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="boardTabBox" position="-63px -96px" size="1580px 57px">
                <Button profile="fs25_subCategorySelectorTabbedTab" id="boardTabs[1]" text="$l10n_uwm_tab_market" onClick="onClickTabMarket">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
                </Button>
                <Button profile="fs25_subCategorySelectorTabbedTab" id="boardTabs[2]" text="$l10n_uwm_tab_myOrders" onClick="onClickTabMyOrders">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
                </Button>
                <Button profile="fs25_subCategorySelectorTabbedTab" id="boardTabs[3]" text="$l10n_uwm_tab_myDeals" onClick="onClickTabMyDeals">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
                </Button>
            </BoxLayout>
            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="-63px -153px" size="100% 2dp" id="boardTabLine"/>
            <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="boardPaging" position="-63px -106px" onClick="onClickBoardPaging"/>

            <!-- MARKET: other farms' open standing orders -->
            <Text profile="uwm_sectionLabel" position="-63px -162px" text="$l10n_uwm_section_market" id="marketHeader"/>
            <SmoothList profile="uwm_list" id="marketList" position="-63px -194px" size="100% 306px" listItemSpacing="12px">
                <ListItem profile="uwm_cardItem">
                    <Bitmap profile="uwm_cardEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardTile" name="uwmImg_tile"/>
                    <Bitmap profile="uwm_cardIcon" name="icon"/>
                    <Text profile="uwm_cardTitle" name="title"/>
                    <Text profile="uwm_cardSub" name="sub"/>
                    <Text profile="uwm_cardStatus" name="status"/>
                    <Text profile="uwm_cardAmount" name="amount"/>
                    <Bitmap profile="uwm_cardArrow" name="uwmImg_arrow"/>
                </ListItem>
            </SmoothList>
            <Text profile="uwm_emptyText" position="540px -320px" id="marketEmpty"/>

            <!-- MARKET, lower panel: your open deals -->
            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="-63px -508px" size="100% 1dp" id="dealsLine"/>
            <Text profile="uwm_sectionLabel" position="-63px -514px" text="$l10n_uwm_dealsTitle" id="dealsHeader"/>
            <SmoothList profile="uwm_list" id="dealsList" position="-63px -546px" size="100% 170px" listItemSpacing="12px">
                <ListItem profile="uwm_cardItem">
                    <Bitmap profile="uwm_cardEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardTile" name="uwmImg_tile"/>
                    <Bitmap profile="uwm_cardIcon" name="icon"/>
                    <Text profile="uwm_cardTitle" name="title"/>
                    <Text profile="uwm_cardSub" name="sub"/>
                    <Text profile="uwm_cardStatus" name="status"/>
                    <Text profile="uwm_cardAmount" name="amount"/>
                    <Bitmap profile="uwm_cardArrow" name="uwmImg_arrow"/>
                </ListItem>
            </SmoothList>
            <Text profile="uwm_emptyText" position="540px -600px" id="dealsEmpty"/>

            <!-- MY ORDERS / MY DEALS: one list of cards -->
            <SmoothList profile="uwm_list" id="boardList" position="-63px -166px" size="100% 550px" listItemSpacing="12px">
                <ListItem profile="uwm_cardItem">
                    <Bitmap profile="uwm_cardEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardBg" name="uwmImg_solid"/>
                    <Bitmap profile="uwm_cardTile" name="uwmImg_tile"/>
                    <Bitmap profile="uwm_cardIcon" name="icon"/>
                    <Text profile="uwm_cardTitle" name="title"/>
                    <Text profile="uwm_cardSub" name="sub"/>
                    <Text profile="uwm_cardStatus" name="status"/>
                    <Text profile="uwm_cardAmount" name="amount"/>
                    <Bitmap profile="uwm_cardArrow" name="uwmImg_arrow"/>
                </ListItem>
            </SmoothList>
            <Text profile="uwm_emptyText" position="540px -400px" id="boardEmpty"/>

            <!-- bottom line + footer: depot status (left), farm manager or not (right) -->
            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="-63px -723px" size="100% 1dp"/>
            <Text profile="uwm_footerText" position="-43px -733px" id="depotText"/>
            <Text profile="uwm_footerTextRight" position="520px -733px" id="managerText"/>
            <!-- delete finished invoices (mock-up previews/menu_v6_delete_finished.png, user OK'd 2026-10-30) -->
            <GuiElement profile="uwm_clearBox" id="clearBox">
                <Bitmap profile="uwm_clearEdge" name="uwmImg_solid"/>
                <Bitmap profile="uwm_clearBg" name="uwmImg_solid"/>
                <Text profile="uwm_clearText" text="$l10n_uwm_button_clearFinished"/>
                <Bitmap profile="uwm_clearCountTile" name="uwmImg_tile"/>
                <Text profile="uwm_clearCount" id="clearCount"/>
                <Button profile="uwm_clearButton" id="clearButton" onClick="onClickClearFinished"/>
            </GuiElement>
        </GuiElement>

        <!-- scroll bars, docked at the right edge like the game's own lists -->
        <ThreePartBitmap profile="uwm_sliderDockedBg" id="invoiceSlider">
            <ThreePartBitmap profile="fs25_sliderDockedBox">
                <Slider profile="uwm_sliderDocked" dataElementId="invoiceList"/>
            </ThreePartBitmap>
        </ThreePartBitmap>
        <ThreePartBitmap profile="uwm_sliderDockedBg" id="boardSlider" visible="false">
            <ThreePartBitmap profile="fs25_sliderDockedBox">
                <Slider profile="uwm_sliderDocked" dataElementId="boardList"/>
            </ThreePartBitmap>
        </ThreePartBitmap>
    </GuiElement>

